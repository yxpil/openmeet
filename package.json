{
  "name": "openmeet",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source desktop meeting app with Electron, WebRTC, LAN/IPv6 and a self-hostable Node.js server",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @openmeet/server",
    "dev:desktop": "npm run dev --workspace @openmeet/desktop",
    "build": "npm run build:server && npm run build:desktop",
    "build:server": "npm run build --workspace @openmeet/server",
    "build:desktop": "npm run build --workspace @openmeet/desktop",
    "start:server": "npm run start --workspace @openmeet/server",
    "test": "npm test --workspace @openmeet/server",
    "typecheck": "npm run typecheck --workspace @openmeet/server && npm run typecheck --workspace @openmeet/desktop",
    "package:win": "npm run package:win --workspace @openmeet/desktop"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
