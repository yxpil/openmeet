{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@openmeet/shared": ["../shared/src/index.ts"],
      "@openmeet/server": ["../server/src/index.ts"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "../server/types/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
